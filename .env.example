# Local LLM
AI_EMS_MODEL=qwen3.5:9b
AI_EMS_LLM_BASE_URL=http://127.0.0.1:11434

# Optional Bearer auth (HTTPS or exact local proxy http://127.0.0.1:18080)
# Do not combine with Cloudflare Access credentials.
AI_EMS_LLM_API_KEY=

# Optional remote Ollama via Cloudflare Access (both required; HTTPS only)
# AI_EMS_LLM_BASE_URL=https://ollama.example.com
AI_EMS_CF_ACCESS_CLIENT_ID=
AI_EMS_CF_ACCESS_CLIENT_SECRET=

# Grid data
AI_EMS_CASE_FILE=data/KPG193_ver2_0_powsybl_full.mat
AI_EMS_BUS_LOCATION_FILE=data/bus_location.csv

# Agent Web UI
AI_EMS_WEB_HOST=127.0.0.1
AI_EMS_WEB_PORT=8000

# Physics API
AI_EMS_PHYSICS_HOST=127.0.0.1
AI_EMS_PHYSICS_PORT=8001

# Logging
AI_EMS_LOG_LEVEL=info
